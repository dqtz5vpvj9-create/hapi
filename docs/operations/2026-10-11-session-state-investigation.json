    "nativeTestsAppendTo": "cli/src/codex/shared/root.test.ts",
    "nativeTestCases": " replay native lifecycle facts without model calls.\nit('audit: native idle must end the displayed running state', async () => {\n    const f = await fixture();\n    f.native.notify('turn/started', { threadId: 'thread', turn: { id: 'audit-turn' } });\n    f.native.notify('thread/status/changed', { threadId: 'thread', status: { type: 'idle' } });\n    await Promise.resolve();\n    const heartbeat = vi.spyOn(f.root.session, 'keepAlive');\n    await f.root.activate();\n    expect(heartbeat.mock.lastCall?.[0]).toBe(false);\n});\nit('audit: a completed turn must not revive from a late duplicate start', async () => {\n    const f = await fixture();\n    f.native.notify('turn/started', { threadId: 'thread', turn: { id: 'audit-turn' } });\n    f.native.notify('turn/completed', { threadId: 'thread', turn: { id: 'audit-turn', status: 'completed' } });\n    f.native.notify('turn/started', { threadId: 'thread', turn: { id: 'audit-turn' } });\n    const heartbeat = vi.spyOn(f.root.session, 'keepAlive');\n    await f.root.activate();\n    expect(heartbeat.mock.lastCall?.[0]).toBe(false);\n});\n",
    "webTestCases": "import { expect, it } from 'vitest'\nimport type { Session } from '@/types/api'\nimport { applySessionDetailPatch } from './sessionPatch'\nit('audit: late running patch cannot replace a newer idle fact', () => {\n const session = { id: 'audit', active: true, thinking: false, activeAt: 3000, updatedAt: 3000 } as Session\n const next = applySessionDetailPatch(session, { active: true, thinking: true, activeAt: 2000 }) ?? session\n expect(next.thinking).toBe(false)\n})\n"
