{
    "name": "hapi",
    "private": true,
    "workspaces": [
        "cli",
        "shared",
        "hub",
        "web",
        "mobile",
        "website",
        "docs",
        "relay"
    ],
    "packageManager": "bun@1.4.0",
    "scripts": {
        "build:site": "bun run --cwd website build && bun run --cwd docs docs:build && cp -r docs/.vitepress/dist website/dist/public/docs",
        "dev": "bun run --parallel dev:hub dev:web",
        "build": "bun run build:cli && bun run build:hub",
        "build:cli": "bun run typecheck:cli",
        "build:single-exe": "bun run download:tunwg && bun run build:web && (cd hub && bun run generate:embedded-web-assets) && (cd cli && bun run build:exe:allinone)",
        "build:single-exe:all": "bun run download:tunwg && bun run build:web && (cd hub && bun run generate:embedded-web-assets) && (cd cli && bun run build:exe:allinone:all)",
        "download:tunwg": "bun run hub/scripts/download-tunwg.ts",
        "build:hub": "cd hub && bun run build",
        "build:web": "cd web && bun run build",
        "build:mobile": "bun run --cwd mobile sync",
        "dev:hub": "cd hub && bun run dev",
        "dev:web": "cd web && bun run dev",
        "typecheck": "bun run --parallel typecheck:cli typecheck:web typecheck:hub typecheck:relay",
        "typecheck:cli": "cd cli && bun run typecheck",
        "typecheck:hub": "cd hub && bun run typecheck",
        "typecheck:relay": "cd relay && bun run typecheck",
        "typecheck:web": "cd web && bun run typecheck",
        "test": "bun run test:mobile && bun run test:cli && bun run test:hub && bun run test:web && bun run test:shared && bun run test:relay && bun run test:integration && bun run test:browser-harness",
        "test:mobile": "bun run --cwd mobile test",
        "test:integration": "bun test tests/*.integration.test.ts",
        "test:browser-harness": "node --test scripts/testing/recent/*.test.mjs scripts/testing/history/*.test.mjs scripts/testing/history/browser/*.test.mjs",
        "test:history-reader": "bun test tests/history-reading.integration.test.ts",
        "test:cli": "cd cli && bun run test",
        "test:cli:integration": "cd cli && bun run test:integration",
        "test:hub": "cd hub && bun run test",
        "test:relay": "cd relay && bun run test",
        "test:web": "cd web && bun run test",
        "test:shared": "cd shared && bun run test",
        "test:e2e": "playwright test",
        "test:dependency-ui": "playwright test typing-replay.spec.ts workspace-lifecycle.spec.ts settings-responsive.spec.ts codex-session-dialog-layout.spec.ts native-attachments.spec.ts native-update.spec.ts",
        "test:built-artifact": "node scripts/testing/built-artifact-smoke.mjs",
        "test:realtime-cohort": "node scripts/testing/built-artifact-smoke.mjs --cohort",
        "test:e2e:tester-army": "cd tests/tester-army && npm test",
        "test:e2e:ui": "playwright test --ui",
        "test:mermaid-lightbox:playwright": "timeout 600 node scripts/dev/mermaid-lightbox-playwright.mjs",
        "test:mermaid-lightbox:live": "timeout 900 env HAPI_LIVE=1 playwright test -c web/playwright.live.config.ts",
        "seed:mermaid-lightbox:session": "bun run scripts/dev/mermaid-lightbox-seed-session-db.ts",
        "gen:fixtures": "cd web && bun scripts/generate-fixtures.ts",
        "clean-session": "bun run hub/scripts/cleanup-sessions.ts",
        "release-all": "cd cli && bun run release-all",
        "test:history-dependencies": "bun test tests/history-dependencies.integration.test.ts",
        "test:codex-lineage": "bun test tests/codex-lineage.integration.test.ts",
        "test:codex-search": "bun test tests/codex-session-search.integration.test.ts tests/codex-catalog.integration.test.ts",
        "check:bundle": "node scripts/testing/check-web-budget.mjs",
        "test:native-fork": "bun test tests/native-fork.integration.test.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "playwright": "1.64.1",
        "react-devtools-core": "^7.0.1",
        "vite-plugin-pwa": "^1.2.0"
    },
    "patchedDependencies": {
        "@assistant-ui/react@0.15.29": "patches/@assistant-ui%2Freact@0.15.29.patch",
        "@tanstack/router-core@1.171.37": "patches/@tanstack%2Frouter-core@1.171.37.patch"
    }
}
